{
  "version": 1,
  "globalExcludes": [
    ".localized",
    "com.apple.bird",
    "com.apple.akd",
    "com.apple.nsurlsessiond",
    "com.apple.containermanagerd",
    "com.apple.iCloudHelper",
    "com.apple.HomeKit",
    "com.apple.homed",
    "com.apple.findmy.fmipcore",
    "com.apple.icloud.fmfd",
    "CloudKit",
    "FamilyCircle",
    "it.nico.maccleaner*"
  ],
  "rules": [
    {
      "id": "user-caches",
      "category": "user-caches",
      "title": "Cache utente",
      "paths": [
        "~/Library/Caches"
      ]
    },
    {
      "id": "sandbox-caches",
      "category": "user-caches",
      "title": "Cache utente",
      "paths": [
        "~/Library/Containers/*/Data/Library/Caches"
      ]
    },
    {
      "id": "electron-caches",
      "category": "app-caches",
      "title": "Cache delle app",
      "paths": [
        "~/Library/Application Support/*/Cache",
        "~/Library/Application Support/*/Code Cache",
        "~/Library/Application Support/*/GPUCache",
        "~/Library/Application Support/*/Service Worker/CacheStorage",
        "~/Library/Application Support/*/DawnWebGPUCache",
        "~/Library/Application Support/*/DawnGraphiteCache",
        "~/Library/Application Support/*/Crashpad/completed"
      ],
      "target": "itself"
    },
    {
      "id": "browser-profile-caches",
      "category": "app-caches",
      "title": "Cache delle app",
      "paths": [
        "~/Library/Application Support/Google/Chrome/*/GPUCache",
        "~/Library/Application Support/BraveSoftware/Brave-Browser/*/GPUCache",
        "~/Library/Application Support/Microsoft Edge/*/GPUCache"
      ],
      "target": "itself"
    },
    {
      "id": "known-app-caches",
      "category": "app-caches",
      "title": "Cache delle app",
      "paths": [
        "~/Library/Application Support/Spotify/PersistentCache/Storage",
        "~/Library/Application Support/Adobe/Common/Media Cache Files",
        "~/Library/Application Support/Adobe/Common/Media Cache"
      ],
      "target": "itself"
    },
    {
      "id": "dev-package-caches",
      "category": "dev-caches",
      "title": "Cache degli strumenti di sviluppo",
      "paths": [
        "~/.gradle/caches",
        "~/.npm/_cacache",
        "~/Library/Caches/Yarn",
        "~/Library/pnpm/store",
        "~/.cache/pip",
        "~/Library/Caches/pip",
        "~/Library/Caches/CocoaPods",
        "~/Library/Caches/org.swift.swiftpm",
        "~/Library/Caches/Homebrew"
      ],
      "target": "itself"
    },
    {
      "id": "user-logs",
      "category": "user-logs",
      "title": "Log utente",
      "paths": [
        "~/Library/Logs"
      ],
      "excludes": [
        "MacCleaner"
      ]
    },
    {
      "id": "sandbox-logs",
      "category": "user-logs",
      "title": "Log utente",
      "paths": [
        "~/Library/Containers/*/Data/Library/Logs"
      ]
    },
    {
      "id": "user-diagnostic-reports",
      "category": "user-logs",
      "title": "Log utente",
      "paths": [
        "~/Library/Logs/DiagnosticReports"
      ],
      "minAgeDays": 7
    },
    {
      "id": "xcode-derived-data",
      "category": "xcode",
      "title": "Xcode",
      "paths": [
        "~/Library/Developer/Xcode/DerivedData"
      ]
    },
    {
      "id": "xcode-device-support",
      "category": "xcode",
      "title": "Xcode",
      "paths": [
        "~/Library/Developer/Xcode/iOS DeviceSupport",
        "~/Library/Developer/Xcode/watchOS DeviceSupport",
        "~/Library/Developer/Xcode/tvOS DeviceSupport",
        "~/Library/Developer/Xcode/visionOS DeviceSupport"
      ],
      "minAgeDays": 90
    },
    {
      "id": "xcode-device-logs",
      "category": "xcode",
      "title": "Xcode",
      "paths": [
        "~/Library/Developer/Xcode/iOS Device Logs"
      ],
      "target": "itself"
    },
    {
      "id": "xcode-documentation-cache",
      "category": "xcode",
      "title": "Xcode",
      "paths": [
        "~/Library/Developer/Xcode/DocumentationCache"
      ],
      "target": "itself"
    },
    {
      "id": "core-simulator-caches",
      "category": "xcode",
      "title": "Xcode",
      "paths": [
        "~/Library/Developer/CoreSimulator/Caches"
      ],
      "target": "itself"
    },
    {
      "id": "xcode-archives",
      "category": "xcode-archives",
      "title": "Archivi Xcode",
      "paths": [
        "~/Library/Developer/Xcode/Archives"
      ],
      "risk": "high",
      "autoSelect": false
    },
    {
      "id": "ios-backups",
      "category": "ios-backups",
      "title": "Backup di iPhone e iPad",
      "paths": [
        "~/Library/Application Support/MobileSync/Backup"
      ],
      "risk": "high",
      "autoSelect": false
    },
    {
      "id": "mail-downloads",
      "category": "mail-attachments",
      "title": "Allegati di Mail scaricati",
      "paths": [
        "~/Library/Containers/com.apple.mail/Data/Library/Mail Downloads"
      ],
      "risk": "medium",
      "autoSelect": false
    },
    {
      "id": "system-caches",
      "category": "system-caches",
      "title": "Cache di sistema",
      "paths": [
        "/Library/Caches"
      ],
      "excludes": [
        "com.apple.*"
      ],
      "risk": "medium",
      "autoSelect": false,
      "needsHelper": true
    },
    {
      "id": "system-logs",
      "category": "system-logs",
      "title": "Log di sistema",
      "paths": [
        "/Library/Logs",
        "/private/var/log",
        "/Library/Logs/CrashReporter/CoreCapture"
      ],
      "excludes": [
        "*.log",
        "asl",
        "DiagnosticMessages",
        "com.apple.xpc.launchd",
        "powermanagement",
        "MacCleaner"
      ],
      "autoSelect": false,
      "needsHelper": true
    }
  ]
}
